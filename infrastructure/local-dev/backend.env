# Local development only. Never reuse these values in staging/production (use secret management).
CV_ENV=local
CV_DATABASE_URL=postgresql+psycopg://cv:cv@postgres:5432/characterverse
CV_QUEUE_BACKEND=rq
CV_REDIS_URL=redis://redis:6379/0
CV_STORAGE_DIR=/srv/var/storage
CV_WORK_DIR=/srv/var/work
CV_PUBLIC_BASE_URL=http://localhost:8000
